{
  "name": "bettergitgraph",
  "displayName": "BetterGitGraph",
  "description": "Beautiful, interactive git graph for VS Code — built for everyone.",
  "version": "1.3.2",
  "publisher": "Renoceros",
  "repository": {
    "type": "git",
    "url": "https://github.com/Renoceros/bettergitgraph"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "graph",
    "history",
    "branches",
    "visualization"
  ],
  "icon": "resources/icon.png",
  "activationEvents": [
    "onCommand:bettergitgraph.open",
    "onCommand:bettergitgraph.fetchAll",
    "workspaceContains:.git"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bettergitgraph.open",
        "title": "BetterGitGraph: Open Graph",
        "icon": "$(git-branch)"
      },
      {
        "command": "bettergitgraph.fetchAll",
        "title": "BetterGitGraph: Fetch All Remotes",
        "icon": "$(cloud-download)"
      }
    ],
    "keybindings": [
      {
        "command": "bettergitgraph.open",
        "key": "ctrl+alt+g",
        "mac": "cmd+ctrl+g"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "bettergitgraph.branchExplorer",
          "name": "Branch Explorer",
          "when": "gitOpenRepositoryCount > 0"
        }
      ]
    },
    "configuration": {
      "title": "BetterGitGraph",
      "properties": {
        "bettergitgraph.layoutDirection": {
          "type": "string",
          "enum": ["TB", "BT", "LR", "RL"],
          "default": "TB",
          "description": "Graph layout direction: Top-to-Bottom (TB), Bottom-to-Top (BT), Left-to-Right (LR), or Right-to-Left (RL)."
        },
        "bettergitgraph.dateFormat": {
          "type": "string",
          "enum": ["local", "relative", "iso"],
          "default": "local",
          "description": "Format for commit timestamps: Local Time (e.g. 19:45 GMT+8), Relative (e.g. 2h ago), or ISO."
        },
        "bettergitgraph.beginnerMode": {
          "type": "boolean",
          "default": true,
          "description": "Enable beginner mode: show plain-English explanations and confirmations for all git operations."
        },
        "bettergitgraph.twoStageConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "Require a 2nd confirmation dialog before executing irreversible destructive Git actions (Reset Hard, Force Push, Force Delete Branch)."
        },
        "bettergitgraph.autoFetchInterval": {
          "type": "number",
          "default": 0,
          "enum": [0, 1, 2, 5, 10, 15, 30, 60],
          "enumDescriptions": [
            "Disabled (manual fetch only)",
            "Every 1 minute",
            "Every 2 minutes",
            "Every 5 minutes",
            "Every 10 minutes",
            "Every 15 minutes",
            "Every 30 minutes",
            "Every 60 minutes"
          ],
          "description": "Interval in minutes for automatically fetching all remotes in the background (0 to disable)."
        },
        "bettergitgraph.mainTrunkStrokeWidth": {
          "type": "number",
          "default": 7,
          "minimum": 2,
          "maximum": 16,
          "description": "Stroke width (thickness) for the central main/master trunk in pixels."
        },
        "bettergitgraph.branchStrokeWidth": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Stroke width (thickness) for feature and bugfix branches in pixels."
        },
        "bettergitgraph.maxCommits": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 50000,
          "description": "Maximum number of commits to load into the graph."
        },
        "bettergitgraph.nodeSize": {
          "type": "number",
          "default": 12,
          "minimum": 8,
          "maximum": 24,
          "description": "Radius of commit nodes in the graph (pixels)."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "bettergitgraph.open"
        },
        {
          "command": "bettergitgraph.fetchAll"
        }
      ],
      "editor/title": [
        {
          "command": "bettergitgraph.open",
          "group": "navigation",
          "when": "gitOpenRepositoryCount > 0"
        }
      ],
      "scm/title": [
        {
          "command": "bettergitgraph.open",
          "group": "navigation"
        },
        {
          "command": "bettergitgraph.fetchAll",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && vite build",
    "compile:host": "node esbuild.js",
    "compile:webview": "vite build",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:webview": "vite build --watch",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && vite build",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@types/dagre": "^0.7.52",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.9.1",
    "esbuild": "^0.23.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-git": "^3.26.0",
    "zustand": "^5.0.0"
  }
}
